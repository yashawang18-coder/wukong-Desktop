{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wukong.local/schemas/asset-registry.schema.json",
  "type": "object",
  "required": ["schema_version", "registry_version", "bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["behavior_id", "selectors", "asset_id", "asset_version"]
      }
    }
  }
}
