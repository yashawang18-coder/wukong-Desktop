{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wukong.local/schemas/pose-catalog.schema.json",
  "type": "object",
  "required": ["schema_version", "poses"],
  "properties": {
    "schema_version": {"const": 1},
    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pose_id", "posture", "awareness", "direction", "equipment", "stable"],
        "properties": {
          "pose_id": {"type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"},
          "stable": {"const": true}
        }
      }
    }
  }
}
