<Window x:Class="Wukong.Desktop.DeveloperLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开发者登录"
        Width="420"
        Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource UxWindow}">
  <Grid Background="{StaticResource PaperBrush}" Margin="24">
    <Border Style="{StaticResource Card}" Margin="0">
      <StackPanel>
        <TextBlock Text="开发者模式" Style="{StaticResource PageTitle}" />
        <TextBlock Text="登录后可查看脱敏上下文、Mock 状态与内部诊断；API Key 始终不可见。"
                   Style="{StaticResource SubText}" Margin="0,6,0,16" />
        <TextBlock Text="密码" FontWeight="SemiBold" />
        <PasswordBox x:Name="PasswordInput" Margin="0,8,0,0" Padding="11,9" KeyDown="PasswordInput_KeyDown" />
        <TextBlock x:Name="LoginStatus" Foreground="{StaticResource RedBrush}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
          <Button Content="登录" Style="{StaticResource PrimaryButton}" Click="Login_Click" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
