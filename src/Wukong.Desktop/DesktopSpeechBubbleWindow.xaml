<Window x:Class="Wukong.Desktop.DesktopSpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        SizeToContent="Height"
        MaxHeight="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
    </Grid.RowDefinitions>
    <Border Background="#F7F5F0"
            BorderBrush="#D5D1C7"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,11"
            Effect="{StaticResource PanelShadow}"
            MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
      <TextBlock x:Name="BubbleText"
                 Foreground="#242622"
                 FontSize="14"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 MaxHeight="145" />
    </Border>
    <Polygon Grid.Row="1"
             Points="0,0 18,0 9,9"
             Fill="#F7F5F0"
             Stroke="#D5D1C7"
             StrokeThickness="1"
             HorizontalAlignment="Center"
             VerticalAlignment="Top" />
  </Grid>
</Window>
