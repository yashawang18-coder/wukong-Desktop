            <Border Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel><TextBlock Text="最近触发" FontWeight="SemiBold" /><TextBlock Text="{Binding LastSource, StringFormat=source: {0}}" /><TextBlock Text="{Binding LastTrigger, StringFormat=trigger: {0}}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,16"><StackPanel><TextBlock Text="当前素材" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentAsset}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel><TextBlock Text="错误" FontWeight="SemiBold" /><TextBlock Text="{Binding LastError}" TextWrapping="Wrap" /></StackPanel></Border>
          </UniformGrid>
          <Grid x:Name="DeveloperDiagnosticsPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,16">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <TextBlock Text="Agent 上下文检查器" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshDiagnostics_Click" />
                </DockPanel>
                <TextBox x:Name="AgentDiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="340" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
              <StackPanel>
                <TextBlock Text="Mock 状态" FontWeight="SemiBold" />
                <TextBlock Text="仅用于对话调试，不修改正式性格基线或动作行为内核。" Style="{StaticResource SubText}" Margin="0,4,0,10" />
                <TextBlock Text="当前行为" Style="{StaticResource SubText}" /><TextBox x:Name="MockBehaviorText" Text="quiet_prone" Style="{StaticResource Field}" />
                <TextBlock Text="活泼度" Style="{StaticResource SubText}" Margin="0,8,0,0" /><Slider x:Name="MockLivelinessSlider" Minimum="0" Maximum="1" Value="0.58" TickFrequency="0.05" />
                <TextBlock Text="信任" Style="{StaticResource SubText}" /><Slider x:Name="MockTrustSlider" Minimum="0" Maximum="1" Value="0.82" TickFrequency="0.05" />
                <TextBlock Text="疲劳" Style="{StaticResource SubText}" /><Slider x:Name="MockFatigueSlider" Minimum="0" Maximum="1" Value="0.28" TickFrequency="0.05" />
                <TextBlock Text="压力" Style="{StaticResource SubText}" /><Slider x:Name="MockStressSlider" Minimum="0" Maximum="1" Value="0.12" TickFrequency="0.05" />
                <TextBlock Text="社交欲望" Style="{StaticResource SubText}" /><Slider x:Name="MockSocialSlider" Minimum="0" Maximum="1" Value="0.54" TickFrequency="0.05" />
                <TextBlock Text="玩耍欲望" Style="{StaticResource SubText}" /><Slider x:Name="MockPlaySlider" Minimum="0" Maximum="1" Value="0.35" TickFrequency="0.05" />
                <TextBlock Text="好奇心" Style="{StaticResource SubText}" /><Slider x:Name="MockCuriositySlider" Minimum="0" Maximum="1" Value="0.48" TickFrequency="0.05" />
                <Button Content="应用 Mock 状态" Style="{StaticResource PrimaryButton}" Click="ApplyMockState_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <TextBlock x:Name="MockStateStatus" Style="{StaticResource SubText}" />
                <Separator Margin="0,12,0,12" />
                <TextBlock Text="Behavior Agent Mock" FontWeight="SemiBold" />
                <CheckBox x:Name="BehaviorAgentMockToggle" Content="EnableBehaviorAgentMock" Margin="0,8,0,6" Checked="BehaviorAgentMockToggle_Changed" Unchecked="BehaviorAgentMockToggle_Changed" />
                <TextBlock Text="Seed" Style="{StaticResource SubText}" />
                <TextBox x:Name="BehaviorAgentSeedText" Text="2408" Style="{StaticResource Field}" />
                <TextBlock Text="Posture" Style="{StaticResource SubText}" />
                <ComboBox x:Name="BehaviorAgentPostureCombo" SelectedIndex="2" Margin="0,0,0,8">
                  <ComboBoxItem Content="Stand" />
                  <ComboBoxItem Content="Sit" />
                  <ComboBoxItem Content="Prone" />
                </ComboBox>
                <TextBlock Text="Activity / Attachment / Sensitivity / Independence / Mischief" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                <Slider x:Name="AgentActivitySlider" Minimum="0" Maximum="100" Value="56" />
                <Slider x:Name="AgentAttachmentSlider" Minimum="0" Maximum="100" Value="62" />
                <Slider x:Name="AgentSensitivitySlider" Minimum="0" Maximum="100" Value="42" />
                <Slider x:Name="AgentIndependenceSlider" Minimum="0" Maximum="100" Value="38" />
                <Slider x:Name="AgentMischiefSlider" Minimum="0" Maximum="100" Value="35" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Apply Agent Mock" Style="{StaticResource SecondaryButton}" Click="ApplyBehaviorAgentMock_Click" />
                  <Button Content="Autonomous Step" Style="{StaticResource SecondaryButton}" Tag="None" Click="BehaviorAgentCommand_Click" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="坐" Style="{StaticResource PrimaryButton}" Tag="Sit" Click="BehaviorAgentCommand_Click" />
                  <Button Content="卧" Style="{StaticResource PrimaryButton}" Tag="Down" Click="BehaviorAgentCommand_Click" />
                  <Button Content="手" Style="{StaticResource PrimaryButton}" Tag="Paw" Click="BehaviorAgentCommand_Click" />
                  <Button Content="跳" Style="{StaticResource PrimaryButton}" Tag="Jump" Click="BehaviorAgentCommand_Click" />
                  <Button Content="转圈" Style="{StaticResource PrimaryButton}" Tag="Spin" Click="BehaviorAgentCommand_Click" />
                  <Button Content="吃" Style="{StaticResource PrimaryButton}" Tag="Eat" Click="BehaviorAgentCommand_Click" />
                </WrapPanel>
                <ItemsControl x:Name="BehaviorAgentMockMotionList" Margin="0,8,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding DisplayName}" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Click="PreviewAsset_Click" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="BehaviorAgentSnapshotText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="160" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}" Visibility="{Binding ElementName=DeveloperDiagnosticsPanel, Path=Visibility}">
            <StackPanel>
              <TextBlock Text="口令动作候选调试" FontWeight="SemiBold" />
              <TextBlock Text="仅用于开发者运行验收；不会加入自主动作池，也不会绕过正式口令运行准入。" Style="{StaticResource SubText}" Margin="0,4,0,12" />
              <ItemsControl x:Name="CommandMotionList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#F7F5F0" CornerRadius="12" Padding="10" Margin="0,0,10,10" Width="250">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BehaviorId}" Style="{StaticResource SubText}" />
                        <TextBlock Text="{Binding FrameCount, StringFormat=frames: {0}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" />
                        <Button Content="强制预览" Tag="{Binding}" Style="{StaticResource PrimaryButton}" Click="ForceCommandMotion_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Visibility="{Binding ElementName=DeveloperDiagnosticsPanel, Path=Visibility}">
            <StackPanel>
              <TextBlock Text="兜风运行调试" FontWeight="SemiBold" />
              <TextBlock Text="已通过 Windows 验收，仅允许主人从右键菜单或控制面板手动触发；不进入自主行为、对话、模型或口令路由。" Style="{StaticResource SubText}" Margin="0,4,0,12" />
              <ItemsControl x:Name="CarRideCandidateList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#F7F5F0" CornerRadius="12" Padding="10" Margin="0,0,10,10" Width="290">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BehaviorId}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PhaseSummary}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                          <Button Content="Preview" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Click="PreviewAsset_Click" />
                          <Button Content="Play car ride" Tag="{Binding}" Style="{StaticResource PrimaryButton}" Click="ShowCarRide_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>          <Border Style="{StaticResource Card}" Visibility="{Binding ElementName=DeveloperDiagnosticsPanel, Path=Visibility}">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock Text="候选动作 profile" FontWeight="SemiBold" />
                <WrapPanel DockPanel.Dock="Right">
                  <Button Content="128px" Tag="128" Style="{StaticResource SecondaryButton}" Click="CandidateSize_Click" />
                  <Button Content="192px" Tag="192" Style="{StaticResource SecondaryButton}" Click="CandidateSize_Click" />
                  <Button Content="256px" Tag="256" Style="{StaticResource SecondaryButton}" Click="CandidateSize_Click" />
                </WrapPanel>
              </DockPanel>
              <TextBlock Text="P2 Windows 验收已通过；此区仅用于开发者调试候选 profile。" Style="{StaticResource SubText}" Margin="0,4,0,12" />
              <ItemsControl x:Name="LifecycleCandidateList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#F7F5F0" CornerRadius="12" Padding="10" Margin="0,0,10,10" Width="290">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BehaviorId}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PhaseSummary}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CandidateProfile, StringFormat=profile: {0}}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                          <Button Content="预览" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Click="PreviewAsset_Click" />
                          <Button Content="立即展示" Tag="{Binding}" Style="{StaticResource PrimaryButton}" Click="ForceLifecycleCandidate_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="本地运行 Trace" FontWeight="SemiBold" />
              <ListBox x:Name="TraceList" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" MinHeight="220" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FBFAF6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="18,0" LastChildFill="False">
        <TextBlock Text="{Binding CurrentAction, StringFormat=action: {0}}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Text="{Binding CurrentPhase, StringFormat=phase: {0}}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
