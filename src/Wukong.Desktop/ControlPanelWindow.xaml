<Window x:Class="Wukong.Desktop.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wukong Control"
        Width="1360"
        Height="880"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource UxWindow}">
  <Grid Background="{StaticResource PaperBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FBFAF6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="28,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource InkBrush}">
            <TextBlock Text="悟" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Wukong 悟" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Phase 1.5 playable loop" FontSize="11" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Padding="12,8" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#5B9B69" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding AgentStatus}" FontSize="12" />
            </StackPanel>
          </Border>
          <Button Content="开发者" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OpenDeveloper_Click" />
          <Button Content="设置（待解锁）" Style="{StaticResource DisabledButton}" Margin="2,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#F0EDE6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,20">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="46" Height="46" CornerRadius="23" Background="#D9D2C6">
              <TextBlock Text="悟" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="悟" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CurrentAction}" FontSize="12" Foreground="{StaticResource MutedBrush}" MaxWidth="126" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentAction}" />
            </StackPanel>
          </StackPanel>
          <Button Style="{StaticResource NavButton}" Content="主人" Tag="Owner" Click="Nav_Click" />
          <Button Style="{StaticResource NavButton}" Content="档案" Tag="Profile" Click="Nav_Click" />
          <Button Style="{StaticResource NavButton}" Content="相册" Tag="Album" Click="Nav_Click" />
          <Button Style="{StaticResource NavButton}" Content="大模型" Tag="Model" Click="Nav_Click" />
          <Button Style="{StaticResource NavButton}" Content="素材" Tag="Assets" Click="Nav_Click" />
          <Button Style="{StaticResource NavButton}" Content="开发者" Tag="Developer" Click="Nav_Click" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Padding="14" BorderBrush="#D5D1C7" BorderThickness="1" CornerRadius="8" Background="#F8F6F1">
          <StackPanel>
            <CheckBox x:Name="DeveloperToggle" Content="开发者模式" Checked="DeveloperToggle_Changed" Unchecked="DeveloperToggle_Changed" />
            <TextBlock Text="Advanced editing and forced simulation stay locked." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="30,26,32,42" VerticalScrollBarVisibility="Auto">
      <Grid HorizontalAlignment="Stretch">
        <StackPanel x:Name="OwnerPage">
          <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Daily companion" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="主人" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding Willingness}" Style="{StaticResource SubText}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="同步（待解锁）" Style="{StaticResource DisabledButton}" />
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="1" Style="{StaticResource Card}" Background="#E8EDE3" MinHeight="276">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid MinHeight="220">
                  <Ellipse Width="145" Height="22" Fill="#336D705A" VerticalAlignment="Bottom" Margin="0,0,0,48" />
                  <Grid Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Fill="#D9D2C6" />
                    <Image x:Name="OwnerAvatarImage" Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Center="66,66" RadiusX="66" RadiusY="66" />
                      </Image.Clip>
                    </Image>
                    <TextBlock x:Name="OwnerAvatarFallback" Text="悟" FontSize="60" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <Button Content="上传头像截图" Style="{StaticResource SecondaryButton}" Click="UploadPetAvatar_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="当前状态" Style="{StaticResource Eyebrow}" />
                  <TextBlock Text="{Binding CurrentAction}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="26" />
                  <TextBlock Text="{Binding Reply}" Style="{StaticResource SubText}" Margin="0,6,0,10" />
                  <WrapPanel>
                    <TextBlock Text="{Binding Energy, StringFormat=Energy {0:P0}}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding Hunger, StringFormat=Hunger {0:P0}}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding Mood, StringFormat=Mood {0:P0}}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding Curiosity, StringFormat=Curiosity {0:P0}}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding Social, StringFormat=Social {0:P0}}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding Stress, StringFormat=Stress {0:P0}}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding Comfort, StringFormat=Comfort {0:P0}}" Margin="0,0,12,8" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" MinHeight="276">
              <StackPanel>
                <TextBlock Text="意愿" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentDisposition}" FontSize="24" Margin="0,8,0,0" />
                <TextBlock Text="{Binding CurrentReason}" Style="{StaticResource SubText}" />
                <TextBlock Text="{Binding LastSource, StringFormat=source: {0}}" Style="{StaticResource SubText}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding LastTrigger, StringFormat=trigger: {0}}" Style="{StaticResource SubText}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}" Margin="16,0,0,16" MinHeight="568">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <TextBlock Text="今日安排" FontWeight="SemiBold" />
                  <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource OrangeSoftBrush}">
                    <TextBlock Text="待解锁" Foreground="{StaticResource OrangeBrush}" FontSize="11" />
                  </Border>
                </DockPanel>
                <StackPanel Margin="0,14,0,0">
                  <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="09:00" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" Width="54" />
                    <TextBlock Text="工作时段，保持安静陪伴" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="13:30" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" Width="54" />
                    <TextBlock Text="轻量活动窗口" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="20:00" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" Width="54" />
                    <TextBlock Text="相册回忆与互动" />
                  </DockPanel>
                </StackPanel>
                <TextBlock Text="本期仅展示 UX 占位，不读取日程后端。" Style="{StaticResource SubText}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </Grid>
          <ListBox x:Name="OwnerChatList" Visibility="Collapsed" />
          <TextBox x:Name="ModelInput" Visibility="Collapsed" />
          <TextBlock x:Name="OwnerChatStatus" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Identity &amp; memory" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="档案" Style="{StaticResource PageTitle}" />
              <TextBlock Text="长期资料、性格底色、关系变化与记忆。" Style="{StaticResource SubText}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="ProfilePetTabButton" Content="宠物档案" Style="{StaticResource PanelTabButtonSelected}" Tag="Pet" Click="ProfileTab_Click" />
            <Button x:Name="ProfileOwnerTabButton" Content="主人档案" Style="{StaticResource PanelTabButton}" Tag="Owner" Click="ProfileTab_Click" />
            <Button x:Name="ProfileRelationTabButton" Content="性格与关系" Style="{StaticResource PanelTabButton}" Tag="Relation" Click="ProfileTab_Click" />
            <Button x:Name="ProfileMemoryTabButton" Content="记忆" Style="{StaticResource PanelTabButton}" Tag="Memory" Click="ProfileTab_Click" />
          </StackPanel>
          <Grid>
            <Border x:Name="ProfilePetPanel" Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="宠物档案" FontWeight="SemiBold" Margin="0,0,0,14" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="名字" Grid.Row="0" Style="{StaticResource SubText}" /><TextBox x:Name="PetNameText" Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" />
                    <TextBlock Text="English" Grid.Row="1" Style="{StaticResource SubText}" /><TextBox x:Name="PetEnglishNameText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,0,0" />
                    <TextBlock Text="生日" Grid.Row="2" Style="{StaticResource SubText}" /><DatePicker x:Name="PetBirthDatePicker" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" />
                    <TextBlock Text="品种" Grid.Row="3" Style="{StaticResource SubText}" /><TextBox x:Name="PetBreedText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,0,0" />
                    <TextBlock Text="阶段" Grid.Row="4" Style="{StaticResource SubText}" /><TextBox x:Name="PetLifeStageText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,0,0" />
                  </Grid>
                  <Button Content="保存宠物档案" Style="{StaticResource PrimaryButton}" Click="SavePetProfile_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="ProfileOwnerPanel" Style="{StaticResource Card}" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="主人档案" FontWeight="SemiBold" />
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="生日" Grid.Row="0" Style="{StaticResource SubText}" />
                    <DatePicker x:Name="OwnerBirthdayPicker" Grid.Row="0" Grid.Column="1" Margin="0,0,0,0" />
                    <TextBlock Text="宠物称呼" Grid.Row="1" Style="{StaticResource SubText}" />
                    <TextBox x:Name="OwnerPetCallNameText" Grid.Row="1" Grid.Column="1" Text="悟空" Style="{StaticResource Field}" Margin="0,8,0,0" />
                    <TextBlock Text="作息" Grid.Row="2" Style="{StaticResource SubText}" />
                    <TextBox x:Name="OwnerScheduleText" Grid.Row="2" Grid.Column="1" Text="09:00-18:00 工作，23:30 后安静" Style="{StaticResource Field}" Margin="0,8,0,0" />
                    <TextBlock Text="陪伴偏好" Grid.Row="3" Style="{StaticResource SubText}" />
                    <TextBox x:Name="OwnerPreferenceText" Grid.Row="3" Grid.Column="1" Text="安静陪伴，不频繁跳大姿态动作" Style="{StaticResource Field}" Margin="0,8,0,0" />
                    <TextBlock Text="备注" Grid.Row="4" Style="{StaticResource SubText}" />
                    <TextBox x:Name="OwnerNotesText" Grid.Row="4" Grid.Column="1" Text="不伪造长期记忆，后续由记忆服务接入。" Style="{StaticResource Field}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="82" Margin="0,8,0,0" />
                  </Grid>
                  <Button Content="保存主人档案" Style="{StaticResource PrimaryButton}" Click="SaveOwnerProfile_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="ProfileRelationPanel" Style="{StaticResource Card}" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="性格与关系" FontWeight="SemiBold" />
                  <TextBlock Text="信任：很信任你" Margin="0,12,0,0" />
                  <TextBlock Text="熟悉度：非常熟悉" />
                  <TextBlock Text="触摸接受度：通常愿意" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                  <TextBlock Text="关系变化" FontWeight="SemiBold" />
                  <TextBlock Text="长期关系曲线、亲密度事件和拒绝偏好仍待后端接入。" Style="{StaticResource SubText}" Margin="0,12,0,0" />
                  <Border Style="{StaticResource Badge}" Margin="0,12,0,0"><TextBlock Text="待解锁" /></Border>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="ProfileMemoryPanel" Style="{StaticResource Card}" Visibility="Collapsed">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <TextBlock Text="对话记忆候选" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshMemory_Click" />
                </DockPanel>
                <TextBlock Text="模型不会自动修改档案、性格或相册。只有人工确认的候选才会作为长期记忆参与后续对话。" Style="{StaticResource SubText}" Margin="0,8,0,12" />
                <ItemsControl x:Name="MemoryCandidateList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#F1EEE6" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" Margin="0,5,0,0" />
                          <WrapPanel Margin="0,8,0,0">
                            <Button Content="确认" Tag="{Binding}" Style="{StaticResource PrimaryButton}" Click="ConfirmMemory_Click" />
                            <Button Content="拒绝" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Click="RejectMemory_Click" />
                            <Button Content="删除" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Click="DeleteMemory_Click" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="MemoryEmptyState" Style="{StaticResource Badge}"><TextBlock Text="还没有记忆候选" /></Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="AlbumPage" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Photo memories" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="相册" Style="{StaticResource PageTitle}" />
              <TextBlock Text="路由到本地真实文件夹，子相册读取 Markdown 描述，素材绑定写入 media 列表。" Style="{StaticResource SubText}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="选择相册目录" Style="{StaticResource PrimaryButton}" Click="ChooseAlbumRoot_Click" />
              <Button Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshAlbum_Click" Margin="8,0,0,0" />
              <Button Content="打开目录" Style="{StaticResource SecondaryButton}" Click="OpenAlbumRoot_Click" Margin="8,0,0,0" />
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <TextBlock x:Name="AlbumRootPathText" Text="No album folder selected" Style="{StaticResource SubText}" />
                <TextBlock x:Name="AlbumStatusText" DockPanel.Dock="Right" Text="0 albums" Style="{StaticResource SubText}" />
              </DockPanel>
              <TextBox x:Name="AlbumRootNoteText" Text="悟空从小到大的日常照片" Style="{StaticResource Field}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="子相册" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="AlbumList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Tag="{Binding}" Click="AlbumItem_Click" BorderThickness="1" BorderBrush="#DEDDD5" Background="#F7F5F0" Padding="8" Margin="0,12,12,0" Width="155">
                          <StackPanel>
                            <Border Height="84" Background="#EEECE5" CornerRadius="8"><Image Source="{Binding ThumbnailPath}" Stretch="Uniform" /></Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource SubText}" />
                            <TextBlock Text="{Binding PhotoCount, StringFormat=photos: {0}}" Style="{StaticResource SubText}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="子相册编辑" FontWeight="SemiBold" />
                <TextBlock x:Name="AlbumSelectedNameText" Text="未选择子相册" FontWeight="SemiBold" Margin="0,10,0,0" />
                <DatePicker x:Name="AlbumDatePicker" Margin="0,10,0,0" />
                <TextBox x:Name="AlbumDescriptionText" Style="{StaticResource Field}" MinHeight="112" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" />
                <TextBlock x:Name="AlbumMarkdownPathText" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="预览" FontWeight="SemiBold" Margin="0,12,0,6" />
                <Border Height="190" Background="#EEECE5" CornerRadius="12" Margin="0,0,0,10"><Image x:Name="AlbumPreviewImage" Stretch="Uniform" /></Border>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                  <Button Content="上一张" Style="{StaticResource SecondaryButton}" Click="AlbumPreviousMedia_Click" />
                  <Button Content="下一张" Style="{StaticResource SecondaryButton}" Click="AlbumNextMedia_Click" />
                  <TextBlock x:Name="AlbumMediaStatusText" DockPanel.Dock="Right" Text="未选择图片" Style="{StaticResource SubText}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="当前素材" FontWeight="SemiBold" Margin="0,8,0,6" />
                <ListBox x:Name="AlbumMediaList" MaxHeight="0" Height="0" Visibility="Collapsed" SelectionChanged="AlbumMediaList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderThickness="0">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8" Background="#F7F5F0">
                        <DockPanel>
                          <Border Width="64" Height="64" Background="#EEECE5" CornerRadius="8" ClipToBounds="True"><Image Source="{Binding FullPath}" Stretch="Uniform" /></Border>
                          <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubText}" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="AlbumMediaEmptyState" Style="{StaticResource Badge}" Visibility="Collapsed"><TextBlock Text="该子相册暂无图片素材" /></Border>
                <TextBlock Text="使用上一张/下一张切换预览；解绑只更新 markdown media，不删除本地原图。" Style="{StaticResource SubText}" Margin="0,8,0,0" />
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="保存描述" Style="{StaticResource PrimaryButton}" Click="SaveAlbumDescription_Click" />
                  <Button Content="新增图片素材" Style="{StaticResource SecondaryButton}" Click="AddAlbumMedia_Click" />
                  <Button x:Name="UnbindAlbumMediaButton" Content="解绑素材" Style="{StaticResource SecondaryButton}" Click="UnbindAlbumMedia_Click" />
                  <Button x:Name="DeleteAlbumMediaButton" Content="删除记录" Style="{StaticResource SecondaryButton}" Click="DeleteAlbumMedia_Click" />
                  <Button Content="打开子相册" Style="{StaticResource SecondaryButton}" Click="OpenSelectedAlbum_Click" />
                  <Button x:Name="DeleteSelectedAlbumButton" Content="删除子相册" Style="{StaticResource SecondaryButton}" Click="DeleteSelectedAlbum_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="ModelPage" Visibility="Collapsed">
          <DockPanel LastChildFill="False" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="AI settings" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="大模型" Style="{StaticResource PageTitle}" />
              <TextBlock Text="模型、记忆和宠物设定以便携文件保存；API Key 仍只保存在 Windows Credential Manager。" Style="{StaticResource SubText}" Margin="0,2,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="清空全部对话" Style="{StaticResource SecondaryButton}" Click="ClearAllConversationHistory_Click" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="ModelConfigTabButton" Content="大模型" Style="{StaticResource PanelTabButtonSelected}" Tag="Model" Click="ModelTab_Click" Margin="0,0,8,0" />
            <Button x:Name="MemoryConfigTabButton" Content="记忆配置" Style="{StaticResource PanelTabButton}" Tag="Memory" Click="ModelTab_Click" Margin="0,0,8,0" />
            <Button x:Name="PetSettingTabButton" Content="宠物设定" Style="{StaticResource PanelTabButton}" Tag="Pet" Click="ModelTab_Click" />
          </StackPanel>
          <Grid Height="520">
