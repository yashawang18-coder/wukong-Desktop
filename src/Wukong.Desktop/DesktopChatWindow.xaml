<Window x:Class="Wukong.Desktop.DesktopChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和悟空说话"
        Width="420"
        Height="286"
        MinWidth="340"
        MinHeight="230"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Style="{StaticResource UxWindow}"
        KeyDown="Window_KeyDown">
  <Border Background="{StaticResource CardBrush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="18"
          Padding="16"
          Effect="{StaticResource PanelShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Content="收起" Style="{StaticResource SecondaryButton}" Click="Collapse_Click" />
        <StackPanel>
          <TextBlock Text="和悟空说话" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="对话与控制面板共享上下文和历史" Style="{StaticResource SubText}" />
        </StackPanel>
      </DockPanel>
      <ListBox x:Name="ChatList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding BubbleBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" MaxWidth="350" HorizontalAlignment="{Binding Alignment}">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="ChatStatus" Grid.Row="2" Style="{StaticResource SubText}" Margin="0,4,0,6" Text="输入消息后按 Enter 发送" />
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ChatInput" Style="{StaticResource Field}" MinHeight="42" MaxHeight="88" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged" />
        <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Cancel_Click" Margin="8,0,0,0" />
        <Button x:Name="SendButton" Grid.Column="2" Content="发送" Style="{StaticResource PrimaryButton}" Click="Send_Click" Margin="8,0,0,0" />
      </Grid>
    </Grid>
  </Border>
</Window>
