<Window x:Class="Wukong.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wukong"
        Width="320"
        Height="320"
        MinWidth="240"
        MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        MouseWheel="Window_MouseWheel">
    <Grid x:Name="Root"
          Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="&#x804A;&#x5929;" Click="ChatMenuItem_Click" />
                <MenuItem Header="&#x5403;&#x4E00;&#x4E0B;&#xFF08;&#x5F85;&#x89E3;&#x9501;&#xFF09;" IsEnabled="False" />
                <MenuItem Header="&#x73A9;&#x4E00;&#x4E0B;">
                    <MenuItem Header="&#x515C;&#x98CE;" Tag="wk.interaction.car_ride" Click="CarRideMenuItem_Click" />
                    <MenuItem Header="&#x6563;&#x6B65;&#xFF08;&#x5F85;&#x89E3;&#x9501;&#xFF09;" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="&#x53E3;&#x4EE4;">
                    <MenuItem Header="&#x5750;" Tag="&#x5750;" Click="OwnerCommandMenuItem_Click" />
                    <MenuItem Header="&#x5367;" Tag="&#x5367;" Click="OwnerCommandMenuItem_Click" />
                    <MenuItem Header="&#x624B;" Tag="&#x624B;" Click="OwnerCommandMenuItem_Click" />
                    <MenuItem Header="&#x8DF3;" Tag="&#x8DF3;" Click="OwnerCommandMenuItem_Click" />
                    <MenuItem Header="&#x8F6C;&#x5708;" Tag="&#x8F6C;&#x5708;" Click="OwnerCommandMenuItem_Click" />
                    <MenuItem Header="&#x5403;" Tag="&#x5403;" Click="OwnerCommandMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="&#x5BA0;&#x7269;&#x9B54;&#x6CD5;">
                    <MenuItem Header="Accio Broom" Tag="wk.magic.accio_broom" Click="MagicMenuItem_Click" />
                    <MenuItem Header="Apparate" Tag="wk.magic.apparate" Click="MagicMenuItem_Click" />
                    <MenuItem Header="Petrificus Totalus" Tag="wk.magic.petrificus_totalus" Click="MagicMenuItem_Click" />
                    <MenuItem Header="Scourgify" Tag="wk.magic.scourgify" Click="MagicMenuItem_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="停下" Click="StopMenuItem_Click" />
                <MenuItem Header="打开面板" Click="OpenPanelMenuItem_Click" />
                <Separator />
                <MenuItem Header="退出" Click="ExitMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Border x:Name="FallbackBadge"
                Width="240"
                Height="240"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="120"
                Background="#CCF7F5F0"
                BorderBrush="#CC49664E"
                BorderThickness="2">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="WK"
                           HorizontalAlignment="Center"
                           FontSize="54"
                           FontWeight="SemiBold"
                           Foreground="#242622" />
                <TextBlock Text="Wukong Phase 1"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#49664E" />
            </StackPanel>
        </Border>

        <Image x:Name="PetImage"
               Width="310"
               Height="310"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseMove="PetImage_MouseMove"
               MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
               MouseWheel="Window_MouseWheel"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border x:Name="ChatSensorHint"
                Height="32"
                Width="92"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Background="Transparent"
                IsHitTestVisible="False" />

        <Border x:Name="PhaseBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="8,3"
                CornerRadius="8"
                Background="#CC242622">
            <TextBlock x:Name="PhaseText"
                       Text="Loading"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFF7F5F0" />
        </Border>
    </Grid>
</Window>
